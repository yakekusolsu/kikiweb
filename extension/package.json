{
  "name": "kikiweb-chrome-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "vue-tsc -b && vite build",
    "build:firefox": "vue-tsc -b && vite build --config vite.firefox.config.ts",
    "lint:firefox": "npx --yes web-ext@10.5.0 lint --source-dir dist-firefox"
  },
  "dependencies": {
    "@lucide/vue": "1.28.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vue-tsc": "2.2.12"
  }
}
